{
  "manifest_version": 3,
  "name": "FediFox",
  "version": "0.1.0",
  "description": "Like, share, follow and reply to the ActivityPub object behind any web page from your own fediverse account.",
  "icons": {
    "48": "icons/symbol-color.svg",
    "96": "icons/symbol-color.svg",
    "128": "icons/symbol-color.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fedifox@pfefferle.org",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "FediFox",
    "default_icon": "icons/symbol.svg",
    "default_popup": "src/popup/popup.html"
  },
  "page_action": {
    "default_icon": "icons/symbol-color.svg",
    "default_title": "FediFox \u2014 this page is on the fediverse",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "identity",
    "contextMenus",
    "webRequest",
    "webNavigation",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/discovery/html.js",
        "src/constants.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
